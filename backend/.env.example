# Copy to backend/.env and fill in. Never commit .env.
# Everything is optional: without a key the app runs with imports, charts,
# competitor browsing, keyword themes, evidence preview and demo mode.

# --- Language model (Anthropic Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (higher = more thorough and more expensive)
AI_EFFORT_REPORT=high
AI_EFFORT_CLASSIFY=low
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=16000
# Lets the API re-run a declined request on a fallback model (server-side). Set false to disable.
AI_ENABLE_FALLBACKS=true

# --- Request-size limits (cost control) ---
AI_MAX_EVIDENCE_CHARS=60000
AI_MAX_EXCERPT_CHARS=500
AI_CLASSIFY_BATCH_SIZE=20
AI_CLASSIFY_MAX_ITEMS=200

# --- Free local AI (Ollama) ---
# Business ideas can run on an open-source model on this Mac. See README.
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:14b
LOCAL_TIMEOUT_SECONDS=900
LOCAL_CONTEXT_TOKENS=32768

# --- Official data updates ---
# Check JNTO and the Japan Tourism Agency for new releases every N hours (0 = off).
AUTO_UPDATE_HOURS=24

# --- App ---
# DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=20971520
